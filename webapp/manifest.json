{
  "_version": "1.53.0",
  "sap.app": {
    "id": "com.socotec.aff.propagdemande",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.29.0",
      "toolsId": "3aba1f75-9207-4a9f-88b7-15b84eee29bf"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_aff_propag_demande/srvd/sap/zui_aff_propag_demande/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
